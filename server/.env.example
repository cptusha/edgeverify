# EdgeVerify server
PORT=4000
NODE_ENV=development
# Required in hosted mode: a random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Leave DATABASE_URL empty to use embedded SQLite (standalone mode).
# Set to a Postgres/Supabase URL for hosted or enterprise mode.
DATABASE_URL=
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Outbound list fetch (set false in air-gapped deployments; fixtures are used instead)
LIST_FETCH_ENABLED=false
LIST_REFRESH_CRON_MINUTES=360
